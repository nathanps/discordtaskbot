# Discord Bot Token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Path to git repository for task storage
# This directory should contain (or will contain) the servers/ folder and config.json
# Examples:
#   Docker: /data (with volume mount)
#   Linux: /home/user/taskbot-data
#   Windows: C:\taskbot-data
REPO_PATH=.

# CSV filename for tasks (default: tasks.csv)
CSV_FILENAME=tasks.csv
